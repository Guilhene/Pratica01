datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres:password@localhost:5432/gestao_financeira?schema=public"
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id           String        @id @default(uuid())
  name         String        @unique
  displayName  String
  icon         String
  background   String
  isIncome     Boolean
  isDefault    Boolean       @default(false)
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Transaction {
  id          String   @id @default(uuid())
  description String
  value       Float
  date        DateTime
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("transactions")
}
