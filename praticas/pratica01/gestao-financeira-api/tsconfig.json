{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "lib": ["es2022"],
    "allowJs": true,
    "outDir": "./dist",
    "rootDir": "./",                           /* Mudamos para a raiz para englobar src e prisma */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]                          /* Força o TypeScript a carregar os tipos do Node.js */
  },
  "include": ["src/**/*", "prisma/**/*"]       /* Agora ele monitora a pasta prisma também */
}